{
  "name": "md-toolkit",
  "version": "1.1.0",
  "private": true,
  "description": "A highly customizable Markdown viewer and editor for Google Chrome.",
  "type": "module",
  "license": "MIT",
  "author": "Szymon Tyburczy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SzymonTyburczy/md-toolkit.git"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide": "^1.69.0",
    "markdown-it": "^15.0.3",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "fflate": "^0.8.3",
    "jsdom": "^31.0.0",
    "puppeteer": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
